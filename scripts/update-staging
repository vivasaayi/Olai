#!/usr/bin/env python3
"""Pull a clean mainline checkout, build and verify a persistent Mac staging deployment."""
import datetime
import fcntl
import json
import os
from pathlib import Path
import subprocess
import tempfile
import urllib.request
import uuid

root = Path(__file__).resolve().parent.parent


def run(arguments, capture=False):
    if capture:
        return subprocess.check_output(arguments, cwd=root, text=True).strip()
    subprocess.run(arguments, cwd=root, check=True)


config = json.loads((root/'deploy/product.json').read_text())
default_branch = config['default_branch']
if run(['git', 'branch', '--show-current'], True) != default_branch:
    raise SystemExit(f'Run scripts/update-staging from the {default_branch} checkout.')
if run(['git', 'status', '--porcelain'], True):
    raise SystemExit('Commit or move checkout changes before updating staging.')
plan = json.loads(run(['bash', 'scripts/env', 'staging', 'plan'], True))
state = Path(plan['state'])
state.mkdir(parents=True, exist_ok=True, mode=0o700)
lock_fd = os.open(state/'update.lock', os.O_CREAT | os.O_RDWR, 0o600)
with os.fdopen(lock_fd, 'w') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    run(['git', 'pull', '--ff-only'])
    if run(['git', 'status', '--porcelain'], True):
        raise SystemExit('The updated checkout must be clean.')
    commit = run(['git', 'rev-parse', 'HEAD'], True)
    run(['bash', 'scripts/build', 'staging'])
    image = run(['docker', 'image', 'inspect', f'{config["id"]}:{commit}', '--format', '{{.Id}}'], True)
    containers = run([
        'docker', 'ps', '-a', '-q', '--filter', f'label=com.docker.compose.project={plan["project"]}',
        '--filter', f'label=com.docker.compose.service={config["app_service"]}',
    ], True).split()
    backup = None
    previous_image = None
    if containers:
        if len(containers) != 1:
            raise SystemExit('Expected one existing staging app container.')
        previous = json.loads(run(['docker', 'inspect', containers[0]], True))[0]
        previous_image = previous['Image']
        volume = next(mount['Name'] for mount in previous['Mounts'] if mount['Destination'] == '/data' and mount['Type'] == 'volume')
        backup = '/data/backups/before-'+uuid.uuid4().hex+'.sqlite'
        run(['docker', 'run', '--rm', '--network', 'none', '--mount', f'type=volume,source={volume},target=/data', image, 'backup', backup])
    run(['bash', 'scripts/deploy', 'staging', '--image', image])
    run(['bash', 'scripts/test', 'staging'])
    run(['npm', 'ci'])
    run(['npx', 'playwright', 'install', 'chromium'])
    run(['bash', 'scripts/test', 'ui', 'staging'])
    url = run(['python3', 'scripts/endpoint', 'staging'], True)
    with urllib.request.urlopen(url+'/health', timeout=15) as response:
        health = json.load(response)
    if health.get('commit') != commit:
        raise SystemExit('The running staging commit differs from the build.')
    container = run([
        'docker', 'ps', '-q', '--filter', f'label=com.docker.compose.project={plan["project"]}',
        '--filter', f'label=com.docker.compose.service={config["app_service"]}',
    ], True)
    info = json.loads(run(['docker', 'inspect', container], True))[0]
    if info['Image'] != image:
        raise SystemExit('The running staging image differs from the tested build.')
    report = {
        'verifiedAt': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'source': str(root), 'branch': default_branch, 'commit': commit, 'image': image,
        'schemaVersion': health['schemaVersion'], 'url': url,
        'tests': ['API acceptance', 'browser authoring', 'browser translation and exports', 'browser legacy import'],
        'previousImage': previous_image, 'backup': backup,
    }
    with tempfile.NamedTemporaryFile(mode='w', dir=state, prefix='deployment-', delete=False) as output:
        json.dump(report, output, indent=2)
        output.write('\n')
        temporary = output.name
    os.replace(temporary, state/'staging-deployment.json')
    print(f'Staging verified at {url}')
    print(f'Deployment record: {state / "staging-deployment.json"}')
